{
  "name": "walkthru-website",
  "version": "1.0.0",
  "private": true,
  "description": "Walkthru Earth - People-First Urban Intelligence Platform",
  "author": "Walkthru Earth",
  "license": "CC-BY-4.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out --listen 3000",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next node_modules",
    "postinstall": "lefthook install",
    "check": "pnpm lint && pnpm type-check && pnpm test && pnpm format:check"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "@deck.gl/react": "^9.4.0",
    "@luma.gl/engine": "^9.4.1",
    "@next/third-parties": "^16.3.5",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "h3-js": "^4.5.0",
    "hyparquet": "^1.30.0",
    "hyparquet-compressors": "^1.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.8.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.433.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.12",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitest/ui": "^5.0.0",
    "lint-staged": "^17.5.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module"
}
